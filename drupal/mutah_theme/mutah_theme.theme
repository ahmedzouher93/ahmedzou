<?php

/**
 * @file
 * Mutah University theme: shows the site app on front-end pages, and Drupal's
 * own content on account pages (login, password reset, profile).
 */

/**
 * Whether the current route should show the Mutah site app.
 */
function mutah_theme_shows_app(): bool {
  $route = (string) \Drupal::routeMatch()->getRouteName();
  // Account and system pages keep their Drupal forms (e.g. /user/login).
  return !preg_match('/^(user\.|entity\.user\.|system\.40[134]|system\.batch_page)/', $route);
}

/**
 * Implements hook_preprocess_html().
 */
function mutah_theme_preprocess_html(array &$variables): void {
  $variables['mutah_app'] = mutah_theme_shows_app();
  if ($variables['mutah_app']) {
    $variables['#attached']['library'][] = 'mutah_theme/app';
    // Content managed in Drupal (module mutah_content): the app reads it from these JSON views
    if (\Drupal::moduleHandler()->moduleExists('mutah_content')) {
      $variables['html_attributes']->setAttribute('data-mutah-api', base_path() . 'api/mutah');
    }
  }
  else {
    $variables['#attached']['library'][] = 'mutah_theme/drupal';
  }
}

/**
 * Implements hook_preprocess_page().
 */
function mutah_theme_preprocess_page(array &$variables): void {
  $variables['mutah_app'] = mutah_theme_shows_app();
}
